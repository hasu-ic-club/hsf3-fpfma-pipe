#project folders
add_folder {rtl}  
add_folder {rtl/aalu}  
add_folder {rtl/common}  
add_folder {rtl/malu}  
add_folder {rtl/preproc}  
add_folder {rtl/renorm}  
add_folder {rtl/rnd_pack}  
add_folder {infra}  
add_folder {infra/rtl}  
add_folder {infra/rtl/datapath}  
add_folder {infra/pkg}  
add_folder {pkg}  

#project files
add_file -verilog -vlog_std sysv -folder {infra/pkg} "../fusesoc_libraries/hasunosora-hdl-infra.git/proj/pkg/hs_ifr_misc_typedefs_pkg.sv"
add_file -verilog -vlog_std sysv -folder {infra/pkg} "../fusesoc_libraries/hasunosora-hdl-infra.git/proj/pkg/hs_math_basic_pkg.sv"
add_file -verilog -vlog_std sysv -folder {infra/rtl/datapath} "../fusesoc_libraries/hasunosora-hdl-infra.git/proj/rtl/datapath/hs_dpath_skid_buffer.sv"
add_file -verilog -vlog_std sysv -folder {pkg} "../proj/pkg/hsf3_typedef_pkg.sv"
add_file -verilog -vlog_std sysv -folder {rtl} "../proj/rtl/hsf3_fpfma_pipe.sv"
add_file -verilog -vlog_std sysv -folder {rtl/preproc} "../proj/rtl/preproc/hsf3_preproc.sv"
add_file -verilog -vlog_std sysv -folder {rtl/aalu} "../proj/rtl/aalu/hsf3_cadder.sv"
add_file -verilog -vlog_std sysv -folder {rtl/aalu} "../proj/rtl/aalu/hsf3_aalu.sv"
add_file -verilog -vlog_std sysv -folder {rtl/common} "../proj/rtl/common/hsf3_lshift.sv"
add_file -verilog -vlog_std sysv -folder {rtl/common} "../proj/rtl/common/hsf3_grs_rshift.sv"
add_file -verilog -vlog_std sysv -folder {rtl/common} "../proj/rtl/common/hsf3_jam_rshift.sv"
add_file -verilog -vlog_std sysv -folder {rtl/common} "../proj/rtl/common/hsf3_bvd.sv"
add_file -verilog -vlog_std sysv -folder {rtl/common} "../proj/rtl/common/hsf3_hblzc.sv"
add_file -verilog -vlog_std sysv -folder {rtl/rnd_pack} "../proj/rtl/rnd_pack/hsf3_rnd_pack.sv"
add_file -verilog -vlog_std sysv -folder {rtl/rnd_pack} "../proj/rtl/rnd_pack/hsf3_grs_round.sv"
add_file -verilog -vlog_std sysv -folder {rtl/malu} "../proj/rtl/malu/hsf3_fma_sp_result_gen.sv"
add_file -verilog -vlog_std sysv -folder {rtl/malu} "../proj/rtl/malu/hsf3_cmul.sv"
add_file -verilog -vlog_std sysv -folder {rtl/malu} "../proj/rtl/malu/hsf3_exp_extract.sv"
