add_file -verilog -vlog_std sysv -folder {rtl/malu} "../proj/rtl/malu/hsf3_exp_sum.sv"
add_file -verilog -vlog_std sysv -folder {rtl/malu} "../proj/rtl/malu/hsf3_mul_sp_result_gen.sv"
